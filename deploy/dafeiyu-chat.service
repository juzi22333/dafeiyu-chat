[Unit]
Description=Dafeiyu Chat (web chat room with fish)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/dafeiyu-chat
Environment=NODE_ENV=production
Environment=PORT=8710
Environment=HOST=127.0.0.1
ExecStart=/usr/bin/node /opt/dafeiyu-chat/server.js
Restart=always
RestartSec=3
# 日志走 journald：journalctl -u dafeiyu-chat -f
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
